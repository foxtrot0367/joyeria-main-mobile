# Database
DATABASE_NAME=joyeria
DATABASE_USERNAME=joyeria_user
DATABASE_PASSWORD=your_secure_password_here
# Para Supabase, configura DATABASE_URL con la cadena JDBC del Session pooler
# (jdbc:postgresql://HOST:PORT/postgres?sslmode=require) y usa las credenciales
# de ese pooler en DATABASE_USERNAME y DATABASE_PASSWORD.
# DATABASE_URL=

# JWT
JWT_SECRET=your_base64_encoded_secret_here
JWT_EXPIRATION=86400000

# App
FRONTEND_URL=http://localhost
SERVER_PORT=8080

# ---- Despliegue (producción) ----
# Genera secretos fuertes; NO reutilices los de ejemplo.
#   JWT_SECRET (Base64, >= 48 bytes):  openssl rand -base64 48
#   DATABASE_PASSWORD:                 openssl rand -base64 24
# Correo ACME para el certificado TLS de Caddy
ACME_EMAIL=admin@example.com
# Dominio público servido por Caddy (ej. aurajoyeria.com). Para pruebas locales: localhost
DOMAIN=localhost
# Subred(es) de proxies de confianza (separa por comas). Docker por defecto: 172.16.0.0/12
TRUSTED_PROXIES=172.16.0.0/12
# Nivel de log del backend en producción (INFO|WARN|ERROR)
LOG_LEVEL=INFO

# Email (opcional)
EMAIL_FROM=no-reply@aurajoyeria.com
# Envío real por SMTP: rellena MAIL_HOST/USERNAME/PASSWORD y EMAIL_ENABLED=true
EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Solo desarrollo: registra los enlaces (reset/pedido) en los logs
EMAIL_LOG_LINK=false

# Payment (optional)
# provider: sandbox (simula la pasarela, solo en dev) | mercadopago (Checkout Pro real)
PAYMENT_PROVIDER=sandbox
PAYMENT_CURRENCY=COP
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública de tu webhook; Mercado Pago la usa para notificar el pago
MERCADOPAGO_NOTIFICATION_URL=

# AI Shopping Assistant (optional)
# Sin proveedor configurado, el asistente funciona en modo determinista
# (interpreta la intención por reglas y usa SIEMPRE productos reales de la BD).
# Para habilitar un proveedor compatible con OpenAI: AI_ENABLED=true y rellena
# AI_API_KEY / AI_BASE_URL / AI_MODEL. La API key NUNCA debe exponerse al frontend.
#
# Ejemplo Groq (gratis, compatible con OpenAI):
#   AI_ENABLED=true
#   AI_PROVIDER=groq
#   AI_API_KEY=<tu key de https://console.groq.com/keys>
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b   (o openai/gpt-oss-20b, más rápido)
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_MAX_MESSAGE_LENGTH=500
AI_MAX_PRODUCTS=4
AI_COMPOSE_RESPONSE=true
AI_TEMPERATURE=0.3

# Asistente interno del panel de administración (solo rol ADMIN).
# Puede usar una API key/modelo propios para aislar el gasto y el contexto.
# Si AI_ADMIN_API_KEY / AI_ADMIN_MODEL quedan vacíos, hereda la config de arriba.
AI_ADMIN_ENABLED=true
AI_ADMIN_API_KEY=
AI_ADMIN_BASE_URL=
AI_ADMIN_MODEL=
AI_ADMIN_TEMPERATURE=0.3
AI_ADMIN_TIMEOUT_SECONDS=0
AI_ADMIN_MAX_MESSAGE_LENGTH=600

# Frontend: muestra/oculta el botón del asistente (true por defecto)
VITE_AI_ASSISTANT_ENABLED=true
# Frontend: muestra/oculta el asistente del panel de administración (true por defecto)
VITE_AI_ADMIN_ENABLED=true

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (disabled — login es solo con email/contraseña.
# Para habilitar: rellenar credenciales de Google Cloud Console
# (OAuth 2.0 Client IDs) y restaurar spring-boot-starter-oauth2-client
# en joyeria-backend/pom.xml junto con la configuración oauth2 en application.yml)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
